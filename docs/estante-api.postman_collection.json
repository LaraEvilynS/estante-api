{
  "info": {
    "name": "Estante API",
    "description": "Collection da API Estante. Veja o README do repositório para importar e usar.\nOrdem sugerida: Saúde > Auth (Login admin) > Livros > Estante > Avaliações.\nOs tokens e ids são salvos automaticamente nas variáveis da collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "livroId",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "avaliacaoId",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@estante.local"
    },
    {
      "key": "adminSenha",
      "value": "COLOQUE_AQUI_A_ADMIN_SENHA_DO_SEU_ENV"
    },
    {
      "key": "emailUsuario",
      "value": "leitor@exemplo.com"
    },
    {
      "key": "senhaUsuario",
      "value": "senhaExemplo123"
    },
    {
      "key": "tokenRecuperacao",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Saúde",
      "item": [
        {
          "name": "Verificar API e banco",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/saude",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "saude"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Cadastro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/cadastro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "cadastro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Leitor Exemplo\",\n  \"email\": \"{{emailUsuario}}\",\n  \"senha\": \"{{senhaUsuario}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login (usuário comum)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailUsuario}}\",\n  \"senha\": \"{{senhaUsuario}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (administrador)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminSenha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Meus dados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/eu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "eu"
              ]
            }
          }
        },
        {
          "name": "Esqueci a senha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/esqueci-senha",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "esqueci-senha"
              ]
            },
            "description": "O e-mail chega no Mailpit (http://localhost:8025). Copie o valor de 'token' do link para a variável tokenRecuperacao.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailUsuario}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Redefinir senha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/redefinir-senha",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "redefinir-senha"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{tokenRecuperacao}}\",\n  \"novaSenha\": \"novaSenhaExemplo123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Usuários (admin)",
      "item": [
        {
          "name": "Listar usuários",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Livros",
      "item": [
        {
          "name": "Listar livros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/livros?busca=dom&pagina=1&limite=12",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livros"
              ],
              "query": [
                {
                  "key": "busca",
                  "value": "dom",
                  "disabled": true
                },
                {
                  "key": "pagina",
                  "value": "1",
                  "disabled": true
                },
                {
                  "key": "limite",
                  "value": "12",
                  "disabled": true
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Buscar livro",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/livros/{{livroId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livros",
                "{{livroId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Criar livro (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/livros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livros"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Dom Casmurro\",\n  \"autor\": \"Machado de Assis\",\n  \"isbn\": \"978-85-359-0277-5\",\n  \"genero\": \"Romance\",\n  \"paginas\": 256,\n  \"sinopse\": \"Bentinho e Capitu.\",\n  \"urlCapa\": \"https://exemplo.com/capa.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  pm.collectionVariables.set('livroId', pm.response.json().livro.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar livro (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/livros/{{livroId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livros",
                "{{livroId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"genero\": \"Clássico\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Remover livro (admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/livros/{{livroId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livros",
                "{{livroId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Estante",
      "item": [
        {
          "name": "Listar minha estante",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/estante?status=LIDO",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estante"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "LIDO",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Adicionar livro à estante",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estante",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estante"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"livroId\": \"{{livroId}}\",\n  \"status\": \"LENDO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  pm.collectionVariables.set('itemId', pm.response.json().item.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/estante/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estante",
                "{{itemId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"LIDO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Remover da estante",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/estante/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "estante",
                "{{itemId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Avaliações",
      "item": [
        {
          "name": "Listar avaliações do livro",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/livros/{{livroId}}/avaliacoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livros",
                "{{livroId}}",
                "avaliacoes"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Avaliar livro (precisa estar LIDO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/livros/{{livroId}}/avaliacoes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "livros",
                "{{livroId}}",
                "avaliacoes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nota\": 5,\n  \"comentario\": \"Excelente leitura.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code < 300) {",
                  "  pm.collectionVariables.set('avaliacaoId', pm.response.json().avaliacao.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar minha avaliação",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/avaliacoes/{{avaliacaoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "avaliacoes",
                "{{avaliacaoId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nota\": 4,\n  \"comentario\": \"Muito bom.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Excluir avaliação (dono ou admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/avaliacoes/{{avaliacaoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "avaliacoes",
                "{{avaliacaoId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}