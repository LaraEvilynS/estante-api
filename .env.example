# Copie este arquivo para .env e ajuste os valores: cp .env.example .env
PORTA=3000

# Banco de dados (PostgreSQL)
BANCO_USUARIO=estante
BANCO_SENHA=troque_esta_senha
BANCO_NOME=estante
URL_BANCO_DADOS=postgresql://estante:troque_esta_senha@banco:5432/estante

# JWT (gere um valor longo e aleatório)
SEGREDO_JWT=troque_por_um_valor_longo_e_aleatorio
EXPIRACAO_JWT=1h

# E-mail (Mailpit local: caixa de entrada em http://localhost:8025)
EMAIL_HOST=mailpit
EMAIL_PORTA=1025
EMAIL_REMETENTE=nao-responder@estante.local
URL_FRONTEND=http://localhost:5173
