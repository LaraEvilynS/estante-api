# Copie este arquivo para .env: cp .env.example .env
# Depois ajuste os valores marcados com [TROCAR].

PORTA=3000

# Banco de dados (PostgreSQL). A URL de conexão é montada automaticamente
# pelo docker-compose a partir destes três valores: não precisa escrevê-la.
BANCO_USUARIO=estante
# [TROCAR] use apenas letras e números (sem símbolos como @ : / #)
BANCO_SENHA=troque_esta_senha
BANCO_NOME=estante

# [TROCAR] Segredo usado para assinar os tokens JWT (mínimo 32 caracteres).
# Para gerar um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SEGREDO_JWT=troque_por_um_valor_longo_e_aleatorio
EXPIRACAO_JWT=1h

# E-mail (Mailpit local: caixa de entrada em http://localhost:8025)
EMAIL_HOST=mailpit
EMAIL_PORTA=1025
EMAIL_REMETENTE=nao-responder@estante.local
VALIDADE_TOKEN_SENHA_MINUTOS=30

# Endereço do front-end (usado no CORS e no link do e-mail de recuperação).
# Se o front rodar em outra porta, altere aqui.
URL_FRONTEND=http://localhost:5173

# Administrador inicial, criado automaticamente na primeira execução.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@estante.local
# [TROCAR] mínimo 8 caracteres
ADMIN_SENHA=troque_esta_senha_admin
